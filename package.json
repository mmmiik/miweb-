{
  "name": "presupuesta-mi-web",
  "version": "2.0.0",
  "description": "Presupuesta mi web: Next.js (interfaz) + Express (API) en un único proyecto",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"node --watch --env-file-if-exists=.env.local server/server.js\" \"next dev -p 3001\"",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "node --test \"server/test/**/*.test.js\"",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openai": "^7.54.0",
    "pdfmake": "^0.3.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
